{
  "name": "billing-software-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise SaaS Billing Software Monorepo",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --recursive --parallel run dev",
    "phase1": "pnpm dev",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --filter @saas/web run lint && pnpm --filter @saas/api run lint"
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "bcrypt",
      "@nestjs/core",
      "@nestjs/common"
    ]
  }
}
