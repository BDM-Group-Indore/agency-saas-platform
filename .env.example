# Server settings
PORT=3000
NODE_ENV=development

# Database connections
# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billing?schema=public"

# MongoDB (Mongoose)
MONGODB_URI="mongodb://localhost:27017/billing"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT secrets
JWT_ACCESS_SECRET="super-secret-access-key-change-in-prod"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-prod"
JWT_REFRESH_EXPIRATION="7d"
