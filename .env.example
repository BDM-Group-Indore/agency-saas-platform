# ─── Server settings ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# ─── Database connections ─────────────────────────────────────────────────────
# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/billing_software?schema=public"

# MongoDB (Mongoose)
MONGODB_URI="mongodb://localhost:27017/billing"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="changeme_in_prod"

# ─── JWT secrets ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="super-secret-access-key-change-in-prod"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-prod"
JWT_REFRESH_EXPIRATION="7d"

# ─── MFA / Auth hardening ─────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of TOTP secrets stored in DB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY="change-this-to-a-64-char-hex-string-in-prod"

# ─── Billing settings ────────────────────────────────────────────────────────
BILLING_CURRENCY="USD"

# ─── ClickHouse (Analytics DB) ───────────────────────────────────────────────
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="default"

# ─── Phase 8: Payment Security (Kunal) ───────────────────────────────────────
# Stripe webhook signing secret — obtain from Stripe Dashboard → Webhooks
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# Razorpay webhook signing secret — obtain from Razorpay Dashboard → Webhooks
# https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Comma-separated list of allowed IPs for the payment webhook endpoint.
# Used as an application-level guard (in addition to Nginx IP allowlist).
# In production, set this to Stripe + Razorpay published CIDR ranges.
# Leave empty to allow all (development mode).
ALLOWED_WEBHOOK_IPS="127.0.0.1,::1"

# Max allowed webhook events per second per IP (Nginx rate limit reference)
RATE_LIMIT_WEBHOOK_RPS=10

# ─── Infrastructure (Nginx / Proxy) ──────────────────────────────────────────
# Public domain used for HTTPS cert provisioning (production only)
PUBLIC_DOMAIN="your-domain.com"

# ─── WhatsApp Webhooks ────────────────────────────────────────────────────────
# Secret token to sign Meta payload events
WHATSAPP_APP_SECRET="your_whatsapp_app_secret_here"
# Challenge verification token
WHATSAPP_VERIFY_TOKEN="your_whatsapp_verify_token_here"

# ─── CORS settings ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty in development to fallback
# to default dev allowlist (http://localhost:3000, http://localhost:3001, etc.).
CORS_ALLOWED_ORIGINS="http://localhost:3001"

# ─── Google Ads OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/ads/callback/google"

# ─── Meta Ads OAuth ──────────────────────────────────────────────────────────
META_CLIENT_ID="your_meta_client_id_here"
META_CLIENT_SECRET="your_meta_client_secret_here"
META_REDIRECT_URI="http://localhost:3000/api/ads/callback/meta"

