# Stage 1: Base & Dependencies
FROM node:22-alpine AS base

# Install build dependencies for native node modules
RUN apk add --no-cache libc6-compat python3 make g++ openssl

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace and configuration files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/

# Install dependencies (including devDependencies for building)
RUN pnpm install --no-frozen-lockfile

# Stage 2: Builder & Runner
FROM base AS builder
COPY . .

# Generate Prisma client for schema and types definition compliance
RUN pnpm --filter @saas/database prisma:generate

# Build the shared packages first so the api compilation succeeds
RUN pnpm --filter @saas/shared-types run build && \
    pnpm --filter @saas/database run build

# Build NestJS application
RUN pnpm --filter @saas/api run build

# Set environment variables for production
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# Run Prisma migrations using the workspace package runner, then start the production API service
CMD ["sh", "-c", "pnpm --filter @saas/database exec prisma migrate deploy && pnpm --filter @saas/api run start:prod"]
