# Exclude package manager and dependency directories
node_modules
**/node_modules

# Exclude build outputs and cache directories
dist
**/dist
.next
apps/web/.next
.turbo

# Exclude local environment and secret files
.env
.env.local
.env.*.local
*.env

# Exclude local database volume mounts
postgres_data
mongo_data
redis_data

# Exclude repository files
.git
.github
*.md

# Exclude logs
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
