datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  domain                String?                @unique
  wabaPhoneNumberId     String?                @unique
  parentId              String?
  parent                Tenant?                @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Tenant[]               @relation("TenantHierarchy")
  logoUrl               String?
  primaryColor          String?                @default("#3b82f6")
  secondaryColor        String?                @default("#1f2937")
  companyName           String?
  supportEmail          String?
  users                 User[]
  companies             Company[]
  contacts              Contact[]
  pipelines             Pipeline[]
  deals                 Deal[]
  activities            Activity[]
  notes                 Note[]
  leads                 Lead[]
  whatsappConversations WhatsAppConversation[]
  whatsappTemplates     WhatsAppTemplate[]
  whatsappBroadcasts    WhatsAppBroadcast[]
  invoices              Invoice[]
  subscription          TenantSubscription?
  promptTemplates       PromptTemplate[]
  paymentTransactions   PaymentTransaction[]
  adAccounts            AdAccount[]
  adCampaigns           AdCampaign[]
  adSyncLogs            AdSyncLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}



model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  password              String
  firstName             String?
  lastName              String?
  role                  String            @default("CLIENT") // SUPER_ADMIN, AGENCY_OWNER, MANAGER, SALES, SUPPORT, CLIENT
  isActive              Boolean           @default(true)
  tokenVersion          Int               @default(0)
  // Auth hardening fields
  failedLoginAttempts   Int               @default(0)
  lockedUntil           DateTime?
  mfaEnabled            Boolean           @default(false)
  mfaSecret             String?           // AES-256-GCM encrypted TOTP secret
  tenantId              String?
  tenant                Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads                 Lead[]
  sentWhatsAppMessages  WhatsAppMessage[]
  sessions              UserSession[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([tenantId])
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique // bcrypt hash of the refresh token
  userAgent   String?
  ipAddress   String?
  lastUsedAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Contact {
  id                    String                 @id @default(cuid())
  firstName             String
  lastName              String?
  email                 String?
  phone                 String?
  companyId             String?
  company               Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals                 Deal[]
  activities            Activity[]
  notes                 Note[]
  whatsappConversations WhatsAppConversation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([companyId])
  @@index([tenantId])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages    Stage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Stage {
  id         String   @id @default(cuid())
  name       String
  order      Int
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pipelineId])
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  value     Float?
  status    String   @default("OPEN") // OPEN, WON, LOST
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities Activity[]
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([tenantId])
}

model Activity {
  id          String   @id @default(cuid())
  type        String // CALL, MEETING, TASK, EMAIL, CHAT
  subject     String
  description String?
  dueDate     DateTime?
  isCompleted Boolean  @default(false)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contactId])
  @@index([dealId])
  @@index([tenantId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([dealId])
  @@index([tenantId])
}

model Lead {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  companyName    String?
  status         String    @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED
  source         String?   @default("MANUAL") // WEB_FORM, MANUAL, COLD_OUTREACH, REFERRAL
  score          Int       @default(0)
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isDuplicate    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([assignedUserId])
  @@index([tenantId])
  @@index([email])
}

model WhatsAppConversation {
  id            String            @id @default(cuid())
  contactId     String?
  contact       Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phoneNumber   String
  lastMessage   String?
  lastMessageAt DateTime          @default(now())
  status        String            @default("OPEN") // OPEN, CLOSED, SNOOZED
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages      WhatsAppMessage[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tenantId, phoneNumber])
  @@index([contactId])
  @@index([tenantId])
  @@index([phoneNumber])
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String               @default("OUTBOUND") // INBOUND, OUTBOUND
  senderId       String?
  sender         User?                @relation(fields: [senderId], references: [id], onDelete: SetNull)
  body           String
  type           String               @default("TEXT") // TEXT, IMAGE, DOCUMENT, TEMPLATE
  status         String               @default("SENT") // SENT, DELIVERED, READ, FAILED
  templateName   String?
  mediaUrl       String?
  providerMessageId String?            @unique
  broadcastId    String?
  broadcast      WhatsAppBroadcast?   @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([providerMessageId])
  @@index([broadcastId])
}

model WhatsAppTemplate {
  id         String              @id @default(cuid())
  name       String
  category   String              @default("UTILITY") // MARKETING, UTILITY, AUTHENTICATION
  language   String              @default("en_US")
  components Json
  status     String              @default("APPROVED") // APPROVED, PENDING, REJECTED
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcasts WhatsAppBroadcast[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model WhatsAppBroadcast {
  id             String           @id @default(cuid())
  name           String
  templateId     String
  template       WhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  status         String           @default("DRAFT") // DRAFT, SENDING, COMPLETED, FAILED
  sentCount      Int              @default(0)
  deliveredCount Int              @default(0)
  readCount      Int              @default(0)
  failedCount    Int              @default(0)
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages       WhatsAppMessage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([templateId])
  @@index([tenantId])
}

// ─── Phase 5: Billing & Subscription ─────────────────────────────────────────

model SubscriptionPlan {
  id            String               @id @default(cuid())
  name          String               @unique // Starter, Agency Pro, Enterprise Scale
  price         Float
  currency      String               @default("USD")
  billingCycle  String               @default("MONTHLY") // MONTHLY, ANNUAL
  maxUsers      Int                  @default(5)
  features      Json                 // array of feature strings
  isActive      Boolean              @default(true)
  subscriptions TenantSubscription[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model TenantSubscription {
  id                 String           @id @default(cuid())
  tenantId           String           @unique
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             String           @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  trialEndsAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([planId])
}

model Invoice {
  id            String               @id @default(cuid())
  invoiceNumber String               // INV-0001 (unique per tenant)
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientName    String
  clientEmail   String?
  amount        Float
  currency      String               @default("USD")
  status        String               @default("DRAFT") // DRAFT, SENT, PAID, VOID, OVERDUE
  dueDate       DateTime
  paidAt        DateTime?
  lineItems     Json                 // [{ description, quantity, unitPrice, total }]
  notes         String?
  businessGstin String?
  clientGstin   String?
  cgst          Float?
  sgst          Float?
  igst          Float?
  taxAmount     Float?
  payments      PaymentTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
}

model PaymentTransaction {
  id                   String    @id @default(cuid())
  invoiceId            String
  invoice              Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount               Float
  status               String    @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentMethod        String    // STRIPE, RAZORPAY, CASH, BANK_TRANSFER
  gatewayTransactionId String?
  gatewayResponse      Json?
  paidAt               DateTime?
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([invoiceId])
  @@index([tenantId])
  @@index([status])
}

// ─── Phase 6: AI Prompt Library ──────────────────────────────────────────────

model PromptTemplate {
  id           String   @id @default(cuid())
  name         String
  category     String   // LEAD_SCORING, CHATBOT, EMAIL_DRAFT, etc.
  systemPrompt String
  userPrompt   String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─── Ads Integration ─────────────────────────────────────────────────────────

model AdAccount {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform     String       // "GOOGLE_ADS", "META_ADS"
  accountId    String       // Ad Account ID on Google/Meta
  accountName  String?
  accessToken  String       // OAuth access token
  refreshToken String?      // OAuth refresh token (primarily Google)
  expiresAt    DateTime?    // token expiration timestamp
  status       String       @default("ACTIVE") // "ACTIVE", "EXPIRED", "ERROR"
  campaigns    AdCampaign[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, platform, accountId])
  @@index([tenantId])
}

model AdCampaign {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adAccountId     String
  adAccount       AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId      String    // Platform-specific campaign ID
  name            String
  spend           Float     @default(0.0)
  budget          Float     @default(0.0)
  leadsGenerated  Int       @default(0)
  roas            Float     @default(0.0)
  status          String    @default("ACTIVE") // "ACTIVE", "PAUSED", "REMOVED"
  platform        String    // "GOOGLE_ADS", "META_ADS"
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, platform, campaignId])
  @@index([tenantId])
  @@index([adAccountId])
}

model AdSyncLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform    String   // "GOOGLE_ADS", "META_ADS", "ALL"
  status      String   // "SUCCESS", "FAILED"
  message     String?  // Error message or summary
  syncedCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

